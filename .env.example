# Select the implementation behind the adapter boundary. Phase 1 uses local only.
FIRST_COMMIT_MODE=local
# Scanner command timeout. Repositories are rejected before a tool is launched if
# they exceed the limits configured in agent/config.py.
FIRST_COMMIT_SCAN_TIMEOUT_SECONDS=60
