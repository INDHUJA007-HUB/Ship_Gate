# Select the implementation behind the adapter boundary. Phase 1 uses local only.
FIRST_COMMIT_MODE=local
# Scanner command timeout. Repositories are rejected before a tool is launched if
# they exceed the limits configured in agent/config.py.
FIRST_COMMIT_SCAN_TIMEOUT_SECONDS=60
# Optional paths when scanner executables are not on PATH.
# FIRST_COMMIT_GITLEAKS_BIN=gitleaks
# FIRST_COMMIT_SEMGREP_BIN=semgrep
# FIRST_COMMIT_CHECKOV_BIN=checkov

# Phase 5 explanations. none (default) renders vetted templates and never calls a model.
# anthropic uses the Claude API (ANTHROPIC_API_KEY or an `ant auth login` profile);
# bedrock uses Claude in Amazon Bedrock with the standard AWS credential chain and AWS_REGION;
# ollama uses only a loopback Ollama daemon and never accepts :cloud model tags.
FIRST_COMMIT_MODEL_PROVIDER=none
# Optional tier overrides. Defaults: claude-haiku-4-5 (small) and claude-opus-5 (large),
# with the anthropic. prefix on Bedrock.
# FIRST_COMMIT_SMALL_MODEL=claude-haiku-4-5
# FIRST_COMMIT_LARGE_MODEL=claude-opus-5
# Large-tier refusal fallbacks are on by default; set to off to disable.
# FIRST_COMMIT_REFUSAL_FALLBACK=on
# Ollama defaults to the qwen3 profile (qwen3:4b small, qwen3:8b large). Models are never
# downloaded automatically. Other profiles: deepseek-r1, mistral, olmo2, gpt-oss, kimi.
# Kimi requires operator-imported local aliases; official Ollama Kimi entries are cloud/retired.
# FIRST_COMMIT_OLLAMA_PROFILE=qwen3
# FIRST_COMMIT_OLLAMA_URL=http://127.0.0.1:11434
# FIRST_COMMIT_OLLAMA_MAX_CONTEXT=131072
# FIRST_COMMIT_OLLAMA_TIMEOUT_SECONDS=600

# Phase 6 chaos testing. Never enable this in a production deployment. Faults are operator
# configuration only and cannot be supplied by a scan request. Examples:
# FIRST_COMMIT_FAULT_INJECTION=enabled
# FIRST_COMMIT_FAULTS=route-safety=crash,gitleaks=transient_after_write:1
